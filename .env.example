# Public frontend config (safe to expose). Used by Vite at build time.
# Leave blank on Render so the browser uses same-origin /api and /ws.
VITE_API_URL=
VITE_WS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Authoritative game server (never put these in the browser).
PORT=8787
HOST=0.0.0.0
GAME_JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DATA_DIR=./data

# Optional Supabase persistence (service role stays server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limits
RATE_LIMIT_ROOM_PER_MIN=8
RATE_LIMIT_CHAT_PER_MIN=40
